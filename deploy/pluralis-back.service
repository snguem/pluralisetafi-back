# PluralisEtafi : backend + MySQL, lancés ensemble au démarrage du serveur.
#
# Installation (en root, depuis le dossier du dépôt) :   sudo ./deploy/install-service.sh
# Le script remplace __APP_DIR__ par le dossier du dépôt et active le service.
[Unit]
Description=PluralisEtafi (backend + MySQL) via Docker Compose
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__APP_DIR__
# démarre MySQL puis le backend (le backend attend que MySQL soit prêt : voir depends_on du compose)
ExecStart=/usr/bin/docker compose up -d --remove-orphans
# `systemctl reload pluralis-back` : reconstruit et relance le backend après un `git pull`
ExecReload=/usr/bin/docker compose up -d --build backend
# arrête les deux conteneurs ; les volumes (base, modèles Excel, logs) sont conservés
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
