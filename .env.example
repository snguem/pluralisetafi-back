# Copy to .env (never commit it) and adjust. Values below are for a local test only.
DB_USERNAME=pluralis
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ---- Your shared Keycloak: nothing about it is hardcoded in the code
# Realm that holds the users
KEYCLOAK_REALM=your-realm
# Public client the frontend logs in with; its client roles are the app roles
# (ADMIN_PLATEFORME, ADMIN_COMPTE, COLLABORATEUR, INVITE)
KEYCLOAK_CLIENT_ID=your-frontend-client
# Service-account client the backend uses to create / block users, and its secret
KEYCLOAK_ADMIN_CLIENT_ID=your-admin-service-client
KEYCLOAK_ADMIN_SERVICE_SECRET=change-me-admin-service-secret
# Address the BROWSER uses (it ends up in the `iss` claim of the tokens)
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Address the BACKEND CONTAINER uses to reach it (signing keys + admin API)
KEYCLOAK_INTERNAL_URL=http://host.docker.internal:8080

# ---- On a VPS
# Keycloak is reachable from the internet: use the same public address for both variables
#   KEYCLOAK_PUBLIC_URL=https://keycloak.example.com
#   KEYCLOAK_INTERNAL_URL=https://keycloak.example.com
# Optional: server time zone, JVM options
#   TZ=Africa/Dakar
#   JAVA_OPTS=-XX:MaxRAMPercentage=65
